
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#080810">
  <meta name="description" content="Your private community space.">
  <title>Community Forum — Private Community</title>

  <!-- The server must expose public/style.css at /style.css -->
  <link rel="stylesheet" href="/style.css?v=2">

  <style>
    /* Small safety styles so the forum remains readable if the external
       stylesheet fails to load. The full design belongs in style.css. */
    .forum-page { margin: 0; min-height: 100vh; }
    .forum-header { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
    .small-brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; }
    .brand-sub { display: block; font-size: 10px; letter-spacing: .14em; opacity: .65; }
    .profile { display: flex; align-items: center; gap: 12px; }
    .profile-name small { display: block; opacity: .65; }
    .forum-layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 24px; max-width: 1250px; margin: 0 auto; padding: 28px 20px; }
    .feed, .sidebar { min-width: 0; }
    .welcome-banner, .stat-card, .composer, .post, .side-card, .empty-state { border: 1px solid rgba(255,255,255,.1); border-radius: 16px; padding: 20px; margin-bottom: 18px; }
    .welcome-banner { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
    .stat-row { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12px; margin: 18px 0; }
    .stat-card { display: flex; align-items: center; gap: 12px; margin: 0; }
    .composer textarea { display: block; width: 100%; min-height: 120px; box-sizing: border-box; margin: 16px 0; resize: vertical; }
    .composer-heading, .composer-footer, .feed-toolbar, .category-tabs, .post-top, .post-actions, .side-title { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .composer-footer { flex-wrap: wrap; }
    .feed-toolbar { margin: 28px 0 16px; }
    .search-form { display: flex; gap: 8px; }
    .search-form input { min-width: 0; }
    .category-tabs { justify-content: flex-start; flex-wrap: wrap; margin-bottom: 18px; }
    .post-author { display: grid; flex: 1; min-width: 0; }
    .post-author span, .muted { opacity: .68; }
    .post-body { white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.75; }
    .avatar, .profile-fallback, .composer-avatar, .big-avatar { display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; flex: 0 0 auto; }
    .avatar, .profile-fallback, .composer-avatar { width: 40px; height: 40px; }
    .tiny { width: 32px; height: 32px; }
    .big-avatar { width: 64px; height: 64px; }
    .profile img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }
    .member { display: flex; align-items: center; gap: 10px; margin: 14px 0; min-width: 0; }
    .member > div { flex: 1; min-width: 0; }
    .member strong, .member small { display: block; overflow-wrap: anywhere; }
    .member small { opacity: .65; }
    .online-dot, .member-status span { display: inline-block; width: 7px; height: 7px; background: #4ade80; border-radius: 50%; }
    .side-footer { text-align: center; opacity: .6; font-size: 10px; letter-spacing: .12em; padding: 16px 0; }
    .primary-button, .ghost-button, .like-button, .delete-button, .search-form button { cursor: pointer; }
    .primary-button.full { width: 100%; }
    .notice { padding: 12px 14px; border: 1px solid rgba(251,113,133,.35); border-radius: 12px; }
    .category-pill { font-size: 11px; }
    @media (max-width: 850px) {
      .forum-layout { grid-template-columns: minmax(0,1fr); }
      .sidebar { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); align-items: start; gap: 14px; }
      .side-card { margin-bottom: 0; }
      .side-footer { grid-column: 1/-1; }
    }
    @media (max-width: 560px) {
      .forum-header { align-items: flex-start; flex-wrap: wrap; padding: 14px; }
      .profile { width: 100%; flex-wrap: wrap; }
      .forum-layout { padding: 18px 12px; }
      .stat-row { grid-template-columns: 1fr; }
      .feed-toolbar { align-items: stretch; flex-direction: column; }
      .search-form { width: 100%; }
      .search-form input { flex: 1; }
      .category-tabs { align-items: stretch; }
      .sidebar { grid-template-columns: minmax(0,1fr); }
      .welcome-banner { align-items: flex-start; }
    }
  </style>
</head>

<body class="forum-page">
<header class="forum-header">
  <a class="small-brand" href="/forum" aria-label="Private Community home">
    <span class="brand-mark">✦</span>
    <span>
      Private Community
      <span class="brand-sub">MEMBERS NETWORK</span>
    </span>
  </a>

  <div class="profile">
    <% if (user.avatar_url) { %>
      <img src="<%= user.avatar_url %>" alt="Profile avatar">
    <% } else { %>
      <span class="profile-fallback"><%= (user.display_name || '?').slice(0, 1).toUpperCase() %></span>
    <% } %>

    <span class="profile-name">
      <%= user.display_name %>
      <small><%= user.email %></small>
    </span>

    <form method="post" action="/logout">
      <button class="ghost-button" type="submit">Log out <span>↗</span></button>
    </form>
  </div>
</header>

<main class="forum-layout">
  <section class="feed">
    <div class="welcome-banner">
      <div>
        <p class="eyebrow">PRIVATE MEMBER SPACE</p>
        <h1>Welcome back, <%= (user.display_name || 'Member').split(' ')[0] %>.</h1>
        <p class="muted">Your people. Your conversations. One private place.</p>
      </div>
      <div class="welcome-orb" aria-hidden="true">✦</div>
    </div>

    <div class="stat-row">
      <div class="stat-card">
        <span class="stat-icon" aria-hidden="true">♙</span>
        <div><strong><%= stats.members %></strong><small>Members</small></div>
      </div>
      <div class="stat-card">
        <span class="stat-icon" aria-hidden="true">▤</span>
        <div><strong><%= stats.posts %></strong><small>Discussions</small></div>
      </div>
      <div class="stat-card">
        <span class="stat-icon" aria-hidden="true">♡</span>
        <div><strong><%= stats.likes %></strong><small>Reactions</small></div>
      </div>
    </div>

    <% if (message === 'post-invalid') { %>
      <p class="notice" role="alert">Posts must contain 1–5000 characters.</p>
    <% } %>

    <form class="composer" method="post" action="/posts">
      <div class="composer-heading">
        <div class="composer-avatar"><%= (user.display_name || '?').slice(0, 1).toUpperCase() %></div>
        <div>
          <label for="body">Start a discussion</label>
          <p>Share something with your community.</p>
        </div>
      </div>

      <textarea id="body" name="body" maxlength="5000" required placeholder="What's on your mind? Share an update, ask a question, or start a conversation…"></textarea>

      <div class="composer-footer">
        <select name="category" aria-label="Post category">
          <option value="General">General</option>
          <option value="Announcements">Announcements</option>
          <option value="Questions">Questions</option>
          <option value="Gaming">Gaming</option>
          <option value="Showcase">Showcase</option>
        </select>
        <span class="muted">Up to 5,000 characters</span>
        <button class="primary-button" type="submit">Publish post <span>↗</span></button>
      </div>
    </form>

    <div class="feed-toolbar">
      <div>
        <h2>Community feed</h2>
        <p class="muted">The latest from your members</p>
      </div>

      <form class="search-form" method="get" action="/forum">
        <input type="search" name="q" value="<%= q %>" placeholder="Search posts or members…" aria-label="Search posts or members">
        <input type="hidden" name="category" value="<%= selectedCategory %>">
        <input type="hidden" name="sort" value="<%= sort %>">
        <button type="submit" aria-label="Search">⌕</button>
      </form>
    </div>

    <nav class="category-tabs" aria-label="Post categories">
      <% ['All', 'General', 'Announcements', 'Questions', 'Gaming', 'Showcase'].forEach(cat => { %>
        <a
          class="<%= selectedCategory === cat ? 'active' : '' %>"
          href="/forum?category=<%= encodeURIComponent(cat) %>&q=<%= encodeURIComponent(q || '') %>&sort=<%= encodeURIComponent(sort || 'newest') %>">
          <%= cat %>
        </a>
      <% }) %>

      <form method="get" action="/forum" class="sort-form">
        <input type="hidden" name="q" value="<%= q %>">
        <input type="hidden" name="category" value="<%= selectedCategory %>">
        <label for="sort" class="sr-only">Sort posts</label>
        <select id="sort" name="sort" onchange="this.form.submit()" aria-label="Sort posts">
          <option value="newest" <%= ['newest', 'desc'].includes(sort) ? 'selected' : '' %>>Newest first</option>
          <option value="oldest" <%= ['oldest', 'asc'].includes(sort) ? 'selected' : '' %>>Oldest first</option>
        </select>
      </form>
    </nav>

    <% if (!posts.length) { %>
      <div class="empty-state">
        <div class="empty-icon" aria-hidden="true">✦</div>
        <h2>No discussions found</h2>
        <p>Try another search or start the first discussion in this category.</p>
        <a href="/forum">Clear filters</a>
      </div>
    <% } %>

    <% posts.forEach(post => { %>
      <article class="post">
        <div class="post-top">
          <div class="avatar"><%= (post.display_name || '?').slice(0, 1).toUpperCase() %></div>

          <div class="post-author">
            <strong><%= post.display_name %></strong>
            <span><%= post.created_at %></span>
          </div>

          <span class="category-pill category-<%= (post.category || 'general').toLowerCase().replace(/[^a-z0-9-]/g, '') %>"><%= post.category %></span>

          <% if (isAdmin) { %>
            <form method="post" action="/admin/posts/<%= post.id %>/delete" onsubmit="return confirm('Delete this post?')">
              <button class="delete-button" type="submit" title="Delete post" aria-label="Delete post">•••</button>
            </form>
          <% } %>
        </div>

        <p class="post-body"><%= post.body %></p>

        <div class="post-actions">
          <form method="post" action="/posts/<%= post.id %>/like">
            <button class="like-button <%= post.liked_by_me ? 'liked' : '' %>" type="submit">
              <span aria-hidden="true"><%= post.liked_by_me ? '♥' : '♡' %></span>
              <%= post.like_count %>
              <%= post.like_count === 1 ? 'like' : 'likes' %>
            </button>
          </form>
          <span class="post-id">DISCUSSION #<%= post.id %></span>
        </div>
      </article>
    <% }) %>
  </section>

  <aside class="sidebar">
    <section class="side-card profile-card">
      <div class="profile-cover"></div>
      <div class="profile-card-body">
        <div class="big-avatar"><%= (user.display_name || '?').slice(0, 1).toUpperCase() %></div>
        <h2><%= user.display_name %></h2>
        <p><%= user.email %></p>
        <div class="member-status"><span></span> Verified member</div>
      </div>
    </section>

    <section class="side-card">
      <div class="side-title"><h2>About this space</h2><span>✦</span></div>
      <p>A private community for approved members. Keep discussions constructive and never share invite links publicly.</p>
      <div class="guideline"><span>01</span> Respect every member</div>
      <div class="guideline"><span>02</span> Keep private things private</div>
      <div class="guideline"><span>03</span> Make the conversation better</div>
    </section>

    <section class="side-card">
      <div class="side-title"><h2>Members</h2><span class="count"><%= members.length %></span></div>

      <div class="member-list">
        <% members.slice(0, 8).forEach(member => { %>
          <div class="member">
            <span class="avatar tiny"><%= (member.display_name || '?').slice(0, 1).toUpperCase() %></span>
            <div>
              <strong><%= member.display_name %></strong>
              <small><%= member.email %></small>
            </div>
            <span class="online-dot" aria-label="Member"></span>
          </div>
        <% }) %>
      </div>

      <% if (members.length > 8) { %>
        <p class="muted member-more">Showing 8 of <%= members.length %> members</p>
      <% } %>
    </section>

    <% if (isAdmin) { %>
      <section class="side-card admin-card">
        <div class="side-title"><h2>Admin tools</h2><span>⚙</span></div>
        <p>Invite someone new into the community.</p>

        <form method="post" action="/admin/invites">
          <label for="expiry">Invite link expires after</label>
          <select id="expiry" name="expiryHours">
            <option value="24">24 hours</option>
            <option value="168" selected>7 days</option>
            <option value="720">30 days</option>
          </select>
          <button class="primary-button full" type="submit">＋ Create invite link</button>
        </form>
      </section>
    <% } %>

    <footer class="side-footer">PRIVATE COMMUNITY <span>•</span> BUILT FOR MEMBERS</footer>
  </aside>
</main>
</body>
</html>
