<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Community Forum</title><link rel="stylesheet" href="/style.css"></head>
<body class="forum-page">
<header class="forum-header"><a class="small-brand" href="/forum"><span class="brand-mark">✦</span><span>Private Community<span class="brand-sub">MEMBERS NETWORK</span></span></a><div class="profile"><% if (user.avatar_url) { %><img src="<%= user.avatar_url %>" alt=""><% } else { %><span class="profile-fallback"><%= (user.display_name || '?').slice(0,1).toUpperCase() %></span><% } %><span class="profile-name"><%= user.display_name %><small><%= user.email %></small></span><form method="post" action="/logout"><button class="ghost-button">Log out <span>↗</span></button></form></div></header>
<main class="forum-layout">
<section class="feed">
  <div class="welcome-banner"><div><p class="eyebrow">PRIVATE MEMBER SPACE</p><h1>Welcome back, <%= user.display_name.split(' ')[0] %>.</h1><p class="muted">Your people. Your conversations. One private place.</p></div><div class="welcome-orb">✦</div></div>
  <div class="stat-row"><div class="stat-card"><span class="stat-icon">♙</span><div><strong><%= stats.members %></strong><small>Members</small></div></div><div class="stat-card"><span class="stat-icon">▤</span><div><strong><%= stats.posts %></strong><small>Discussions</small></div></div><div class="stat-card"><span class="stat-icon">♡</span><div><strong><%= stats.likes %></strong><small>Reactions</small></div></div></div>
  <% if (message === 'post-invalid') { %><p class="notice">Posts must contain 1–5000 characters.</p><% } %>
  <form class="composer" method="post" action="/posts"><div class="composer-heading"><div class="composer-avatar"><%= (user.display_name || '?').slice(0,1).toUpperCase() %></div><div><label for="body">Start a discussion</label><p>Share something with your community.</p></div></div><textarea id="body" name="body" maxlength="5000" required placeholder="What's on your mind? Share an update, ask a question, or start a conversation…"></textarea><div class="composer-footer"><select name="category" aria-label="Post category"><option>General</option><option>Announcements</option><option>Questions</option><option>Gaming</option><option>Showcase</option></select><span class="muted">Up to 5,000 characters</span><button class="primary-button" type="submit">Publish post <span>↗</span></button></div></form>
  <div class="feed-toolbar"><div><h2>Community feed</h2><p class="muted">The latest from your members</p></div><form class="search-form" method="get" action="/forum"><input type="search" name="q" value="<%= q %>" placeholder="Search posts or members…"><input type="hidden" name="category" value="<%= selectedCategory %>"><input type="hidden" name="sort" value="<%= sort %>"><button aria-label="Search">⌕</button></form></div>
  <nav class="category-tabs"><% ['All','General','Announcements','Questions','Gaming','Showcase'].forEach(cat => { %><a class="<%= selectedCategory === cat ? 'active' : '' %>" href="/forum?category=<%= encodeURIComponent(cat) %>&q=<%= encodeURIComponent(q) %>&sort=<%= sort %>"><%= cat %></a><% }) %><form method="get" action="/forum" class="sort-form"><input type="hidden" name="q" value="<%= q %>"><input type="hidden" name="category" value="<%= selectedCategory %>"><select name="sort" onchange="this.form.submit()" aria-label="Sort posts"><option value="newest" <%= sort === 'desc' ? 'selected' : '' %>>Newest first</option><option value="oldest" <%= sort === 'asc' ? 'selected' : '' %>>Oldest first</option></select></form></nav>
  <% if (!posts.length) { %><div class="empty-state"><div class="empty-icon">✦</div><h2>No discussions found</h2><p>Try another search or start the first discussion in this category.</p><a href="/forum">Clear filters</a></div><% } %>
  <% posts.forEach(post => { %><article class="post"><div class="post-top"><div class="avatar"><%= (post.display_name || '?').slice(0,1).toUpperCase() %></div><div class="post-author"><strong><%= post.display_name %></strong><span><%= post.created_at %></span></div><span class="category-pill category-<%= post.category.toLowerCase() %>"><%= post.category %></span><% if (isAdmin) { %><form method="post" action="/admin/posts/<%= post.id %>/delete" onsubmit="return confirm('Delete this post?')"><button class="delete-button" title="Delete post">•••</button></form><% } %></div><p class="post-body"><%= post.body %></p><div class="post-actions"><form method="post" action="/posts/<%= post.id %>/like"><button class="like-button <%= post.liked_by_me ? 'liked' : '' %>" type="submit"><span><%= post.liked_by_me ? '♥' : '♡' %></span> <%= post.like_count %> <%= post.like_count === 1 ? 'like' : 'likes' %></button></form><span class="post-id">DISCUSSION #<%= post.id %></span></div></article><% }) %>
</section>
<aside class="sidebar">
  <section class="side-card profile-card"><div class="profile-cover"></div><div class="profile-card-body"><div class="big-avatar"><%= (user.display_name || '?').slice(0,1).toUpperCase() %></div><h2><%= user.display_name %></h2><p><%= user.email %></p><div class="member-status"><span></span> Verified member</div></div></section>
  <section class="side-card"><div class="side-title"><h2>About this space</h2><span>✦</span></div><p>A private community for approved members. Keep discussions constructive and never share invite links publicly.</p><div class="guideline"><span>01</span> Respect every member</div><div class="guideline"><span>02</span> Keep private things private</div><div class="guideline"><span>03</span> Make the conversation better</div></section>
  <section class="side-card"><div class="side-title"><h2>Members</h2><span class="count"><%= members.length %></span></div><div class="member-list"><% members.slice(0,8).forEach(member => { %><div class="member"><span class="avatar tiny"><%= (member.display_name || '?').slice(0,1).toUpperCase() %></span><div><strong><%= member.display_name %></strong><small><%= member.email %></small></div><span class="online-dot"></span></div><% }) %></div><% if (members.length > 8) { %><p class="muted member-more">Showing 8 of <%= members.length %> members</p><% } %></section>
  <% if (isAdmin) { %><section class="side-card admin-card"><div class="side-title"><h2>Admin tools</h2><span>⚙</span></div><p>Invite someone new into the community.</p><form method="post" action="/admin/invites"><label for="expiry">Invite link expires after</label><select id="expiry" name="expiryHours"><option value="24">24 hours</option><option value="168" selected>7 days</option><option value="720">30 days</option></select><button class="primary-button full" type="submit">＋ Create invite link</button></form></section><% } %>
  <footer class="side-footer">PRIVATE COMMUNITY <span>•</span> BUILT FOR MEMBERS</footer>
</aside></main></body></html>